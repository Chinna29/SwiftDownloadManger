{
  "name": "swiftfetch",
  "productName": "SwiftFetch",
  "version": "0.2.0",
  "description": "Open-source segmented download manager with pause/resume, queue and browser integration",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "shortcut": "vite build && node scripts/make-shortcut.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.6",
    "https-proxy-agent": "^7.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socks-proxy-agent": "^8.0.5",
    "webtorrent": "^2.8.5"
  },
  "build": {
    "appId": "com.swiftfetch.app",
    "productName": "SwiftFetch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "uint8-util": "2.2.6"
  }
}
